# PRAMAAN AI Configuration

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=4096

# Tavily Search API
TAVILY_API_KEY=your_tavily_api_key_here

# Database Configuration (Neon DB - Serverless PostgreSQL)
DATABASE_URL=postgresql://neondb_user:neondb_password@ep-neon-db.us-east-2.aws.neon.tech/neondb?sslmode=require
# Get your connection string from https://console.neon.tech
# For local development: DATABASE_URL=postgresql://user:password@localhost/pramaan

# Qdrant Vector Database Configuration
QDRANT_URL=localhost:6333
# For Qdrant Cloud: QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=pramaan

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Application Configuration
APP_NAME=PRAMAAN AI
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=*

# Optional: OpenAlex API (for academic research)
# OPENALEX_EMAIL=your_email@example.com

# Optional: Semantic Scholar API
# SEMANTIC_SCHOLAR_API_KEY=your_api_key_here

# Security Configuration
SECRET_KEY=your_secret_key_here_for_jwt
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Cache Configuration
CACHE_ENABLED=True
CACHE_TTL_SECONDS=3600

# Retry Configuration
RETRY_ENABLED=True
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_SECONDS=1
